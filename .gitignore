# ==========================================================================
# RAJIVAN REAL ESTATE – MASTER GITIGNORE
# Prevents security leaks and dependency pollution in version control
# ==========================================================================

# Critical Security / API Keys (NEVER remove this)
.env
.env.local
.env.development
.env.test
.env.production
*.env
*.pem
*.key

# Local Node Dependencies (Massive folders generated by npm install)
node_modules/
jspm_packages/
web_modules/

# Runtime Logs & Debugging dumps
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic / Coverage reports
coverage/
.nyc_output/

# Operating System System Files (Junk files added by Windows/Mac)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local Text Editor / IDE Workspaces
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp