<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="page-hero" style="padding: 3rem 0 2rem 0;">
  <div class="page-hero__bg"></div>
  <div class="page-hero__accent"></div>
  <div class="container">
    <div class="page-hero__label">System Core Modification Portal</div>
    <h1 class="page-hero__title" style="font-size: 2.5rem; line-height: 3rem;">EDIT PARCEL<br><em>MANIFEST.</em></h1>
  </div>
</section>

<section class="contact-page" style="padding-top: 2rem; padding-bottom: 6rem;">
  <div class="container" style="max-width: 600px;">
    
    <div class="contact-form-box" style="background: var(--bg-card); border: 1px solid var(--border); padding: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 2rem;">
        <h2 class="form-heading" style="margin: 0; font-size: 1.2rem;">Tracking ID: <span style="color: var(--orange);"><%= parcel.trackingId %></span></h2>
        <a href="/dispatch/office" style="color: var(--muted); font-family: var(--font-mono); font-size: 0.8rem; text-decoration: none;">✕ Cancel</a>
      </div>

      <% if (error) { %>
        <div style="background: rgba(231, 76, 60, 0.1); border: 1px solid #e74c3c; padding: 1rem; border-radius: var(--radius); color: #e74c3c; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.85rem;">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/dispatch/edit/<%= parcel._id %>">
        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label style="display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.8rem; text-transform: uppercase; font-family: var(--font-mono);">Sender Profile Name</label>
          <input type="text" name="sender" value="<%= parcel.sender %>" required style="width: 100%; padding: 0.85rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--orange); outline: none;">
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label style="display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.8rem; text-transform: uppercase; font-family: var(--font-mono);">Recipient Destination City</label>
          <input type="text" name="recipient" value="<%= parcel.recipient %>" required style="width: 100%; padding: 0.85rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--orange); outline: none;" placeholder="e.g. batticaloa">
          <small style="display: block; color: var(--muted); font-size: 0.75rem; margin-top: 0.3rem;">Must exactly match a keyword inside the commission matrix dictionary.</small>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
          <div class="form-group">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.8rem; text-transform: uppercase; font-family: var(--font-mono);">Weight Bracket</label>
            <input type="text" name="weight" value="<%= parcel.weight %>" required style="width: 100%; padding: 0.85rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--orange); outline: none;">
          </div>
          <div class="form-group">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.8rem; text-transform: uppercase; font-family: var(--font-mono);">Service Tier</label>
            <select name="service" style="width: 100%; padding: 0.85rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--orange); outline: none; height: 46px;">
              <option value="Standard Next-Day Delivery" <%= parcel.service === 'Standard Next-Day Delivery' ? 'selected' : '' %>>Standard Next-Day</option>
              <option value="Xpress Same-Day Zone Transfer" <%= parcel.service === 'Xpress Same-Day Zone Transfer' ? 'selected' : '' %>>Xpress Same-Day</option>
            </select>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 2.5rem;">
          <label style="display: block; margin-bottom: 0.5rem; color: var(--muted); font-size: 0.8rem; text-transform: uppercase; font-family: var(--font-mono);">Cash On Delivery (COD) Total [LKR]</label>
          <input type="number" name="codPrice" value="<%= parcel.codPrice %>" required style="width: 100%; padding: 0.85rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--orange); outline: none;">
        </div>

        <button type="submit" class="track-btn" style="width: 100%; justify-content: center; padding: 1rem; background: var(--orange); color: var(--white); font-weight: bold; border: none; border-radius: var(--radius); cursor: pointer;">
          Commit Log Modifications
        </button>
      </form>
    </div>

  </div>
</section>

<%- include('partials/footer') %>