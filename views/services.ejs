<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero__bg"></div>
  <div class="page-hero__accent"></div>
  <div class="container">
    <div class="page-hero__label">Techo Xpress / Services</div>
    <h1 class="page-hero__title">EVERY DELIVERY.<br><em>EVERY</em> TIME.</h1>
  </div>
</section>

<!-- SAME-DAY EXPRESS -->
<section class="service-block" id="sameday">
  <div class="container">
    <div class="service-block__inner">
      <div>
        <span class="badge">Most Popular</span>
        <div class="service-block__num" style="margin-top:0.75rem;">SERVICE 01</div>
        <h2 class="service-block__title">Same-Day Express</h2>
        <p>Pickup and delivery within the same business day. When time is the priority, Same-Day Express is the answer. We collect from your location and deliver before end of day.</p>
        <p>Available across Greater Colombo and selected districts, with live rider GPS so you know exactly where your package is at every moment.</p>
        <div class="feature-list">
          <div class="feature-item">Colombo metro: within 4 hours</div>
          <div class="feature-item">Live rider GPS tracking</div>
          <div class="feature-item">Digital Proof of Delivery (photo + signature)</div>
          <div class="feature-item">WhatsApp status notifications</div>
          <div class="feature-item">Parcels up to 10 kg</div>
        </div>
        <a href="/contact?service=sameday" class="btn btn-primary" style="margin-top:1.5rem;">
          Get a Quote
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <div class="service-block__visual reveal">
        <div class="service-block__visual-emoji">⚡</div>
        <svg viewBox="0 0 380 280" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:88%; position:relative; z-index:1;">
          <rect x="20" y="20" width="340" height="240" rx="6" fill="#1E1E1E" stroke="rgba(212,79,10,0.25)" stroke-width="1"/>
          <rect x="20" y="20" width="340" height="38" rx="6" fill="#252525"/>
          <circle cx="44" cy="39" r="6" fill="#D44F0A" opacity="0.7"/>
          <circle cx="62" cy="39" r="6" fill="#D44F0A" opacity="0.4"/>
          <circle cx="80" cy="39" r="6" fill="#D44F0A" opacity="0.2"/>
          <text x="40" y="82" fill="#D44F0A" font-family="monospace" font-size="10">SHIPMENT: TXT-2025-008</text>
          <text x="40" y="102" fill="rgba(255,255,255,0.45)" font-family="monospace" font-size="9">STATUS: OUT FOR DELIVERY</text>
          <rect x="40" y="116" width="200" height="4" rx="2" fill="#D44F0A"/>
          <rect x="40" y="116" width="280" height="4" rx="2" fill="rgba(255,255,255,0.07)" style=""/>
          <!-- progress bar -->
          <rect x="40" y="116" width="280" height="4" rx="2" fill="rgba(255,255,255,0.06)"/>
          <rect x="40" y="116" width="200" height="4" rx="2" fill="#D44F0A"/>
          <text x="40" y="140" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="9">ETA: TODAY  3:45 PM</text>
          <text x="40" y="158" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="9">RIDER: 2.4 KM AWAY</text>
          <!-- ping dot -->
          <circle cx="310" cy="170" r="16" fill="rgba(212,79,10,0.12)"/>
          <circle cx="310" cy="170" r="8"  fill="rgba(212,79,10,0.25)"/>
          <circle cx="310" cy="170" r="4"  fill="#D44F0A"/>
          <line x1="268" y1="170" x2="300" y2="170" stroke="#D44F0A" stroke-width="1.5" stroke-dasharray="4 2"/>
          <text x="265" y="205" fill="rgba(212,79,10,0.7)" font-family="monospace" font-size="8" text-anchor="middle">RIDER LIVE</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- STANDARD DELIVERY -->
<section class="service-block" id="standard">
  <div class="container">
    <div class="service-block__inner reverse">
      <div>
        <div class="service-block__num">SERVICE 02</div>
        <h2 class="service-block__title">Standard Delivery</h2>
        <p>Dependable 1–3 day delivery to all 25 districts of Sri Lanka. Our standard service balances speed and cost — the default choice for most B2C and B2B shipments.</p>
        <p>Every parcel is assigned a tracking ID at pickup and monitored through each milestone — sorting, hub transfer, out for delivery, and confirmed receipt.</p>
        <div class="feature-list">
          <div class="feature-item">Island-wide, all 25 districts</div>
          <div class="feature-item">1–3 business day delivery window</div>
          <div class="feature-item">Full tracking with milestone updates</div>
          <div class="feature-item">COD (Cash on Delivery) available</div>
          <div class="feature-item">Parcels up to 30 kg</div>
        </div>
        <a href="/contact?service=standard" class="btn btn-primary" style="margin-top:1.5rem;">
          Get a Quote
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <div class="service-block__visual reveal">
        <div class="service-block__visual-emoji">🚚</div>
        <svg viewBox="0 0 380 280" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:88%; position:relative; z-index:1;">
