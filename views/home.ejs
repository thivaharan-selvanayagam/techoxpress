<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- HERO -->
<!-- ── VIEWPORT-LOCKED HERO TERMINAL REDESIGN ── -->
<section class="hero" style="height: calc(100vh - 70px); min-height: 580px; padding: 0; background: var(--bg); position: relative; overflow: hidden; display: flex; align-items: center;">
  <!-- Underlying layout grid -->
  <div class="hero__grid" style="position: absolute; inset: 0; background-image: linear-gradient(rgba(212,79,10,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(212,79,10,0.02) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none;"></div>
  
  <!-- Subtle decorative radial background blur -->
  <div style="position: absolute; bottom: -10%; left: -5%; width: 350px; height: 350px; background: var(--orange-glow); filter: blur(100px); border-radius: 50%; pointer-events: none; opacity: 0.5;"></div>

  <div class="container" style="position: relative; z-index: 10; width: 100%;">
    <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; align-items: center;">
      
      <!-- LEFT BLOCK: BRAND VALUATION & ACTIONS -->
      <div class="hero__content" style="max-width: 100%; padding-bottom: 20px;">
        <div class="hero__eyebrow" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--bg-card); padding: 0.35rem 0.85rem; border-radius: 100px; border: 1px solid var(--border); font-size: 0.78rem; color: var(--text); font-weight: 600; margin-bottom: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.01);">
          <div class="hero__eyebrow-dot" style="width: 6px; height: 6px; background: var(--orange); border-radius: 50%; animation: pulse 1.8s ease infinite;"></div>
          Sri Lanka's Premium Courier Network
        </div>

        <h1 class="hero__title" style="font-size: clamp(2.5rem, 4.8vw, 4.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; color: #0F172A; margin-bottom: 1rem; text-transform: none;">
          Logistics Driven By <span style="color: var(--orange);">Speed.</span><br>
          Optimized By <em>Precision.</em>
        </h1>

        <p class="hero__desc" style="font-size: 1.05rem; color: var(--muted); line-height: 1.6; max-width: 500px; margin-bottom: 2rem;">
          From instant same-day express shifts to complex corporate supply links—Techo Xpress moves your cargo with automated reliability, trackable 24/7.
        </p>

        <div class="hero__actions" style="display: flex; gap: 0.85rem; flex-wrap: wrap;">
          <a href="/contact" class="btn btn-primary" style="box-shadow: 0 4px 12px var(--orange-glow); padding: 0.85rem 1.8rem;">
            Get a Quote
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a href="/tracking" class="btn btn-outline" style="padding: 0.85rem 1.8rem; background: var(--bg-card);">
            Track Shipment
          </a>
        </div>
      </div>

      <!-- RIGHT BLOCK: COMPACT VIEWPORT CONTROL CENTER GRID -->
      <div class="hero__visual-matrix">
        <div class="ref-card" style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.75rem; border-radius: 8px; box-shadow: 0 12px 32px rgba(15,23,42,0.03); border-top: 3px solid var(--orange);">
          
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
            <div>
              <h3 style="font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: #0F172A; text-transform: uppercase; margin: 0; letter-spacing: 0.02em;">Operations Dashboard</h3>
              <span style="font-family: var(--font-mono); font-size: 0.7rem; color: #10b981; font-weight: 700; text-transform: uppercase; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.15rem;">
                <span style="width:5px; height:5px; background:#10b981; border-radius:50%;"></span> Fleet Vectors Secure
              </span>
            </div>
          </div>

          <!-- High-density metric layout fields -->
          <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            
            <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg-raised); padding: 0.85rem 1.1rem; border-radius: 6px; border: 1px solid var(--border);">
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.25rem;">⏱️</span>
                <span style="font-size: 0.88rem; font-weight: 600; color: var(--text);">On-Time Target Level</span>
              </div>
              <div class="hero__stat-val" style="font-size: 1.6rem; font-weight: 800; color: var(--orange); text-align: right;"><span data-count="98" data-suffix="%">0%</span></div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg-raised); padding: 0.85rem 1.1rem; border-radius: 6px; border: 1px solid var(--border);">
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.25rem;">🗺️</span>
                <span style="font-size: 0.88rem; font-weight: 600; color: var(--text);">Operational Hub Districts</span>
              </div>
              <div class="hero__stat-val" style="font-size: 1.6rem; font-weight: 800; color: #0F172A; text-align: right;"><span data-count="25" data-suffix="+">0+</span></div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg-raised); padding: 0.85rem 1.1rem; border-radius: 6px; border: 1px solid var(--border);">
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.25rem;">📦</span>
                <span style="font-size: 0.88rem; font-weight: 600; color: var(--text);">System Shipments / Mo</span>
              </div>
              <div class="hero__stat-val" style="font-size: 1.6rem; font-weight: 800; color: #0F172A; text-align: right;"><span data-count="500" data-suffix="+">0+</span></div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- TICKER MARQUEE RUNWAY TRACK (Locked directly to container baseline) -->
  <div class="hero__ticker" aria-hidden="true" style="position: absolute; bottom: 0; left: 0; width: 100%; height: 38px;">
    <div class="hero__ticker-track">
      <span>Same-Day Express Delivery</span>
      <span>Real-Time Package Tracking</span>
      <span>Corporate Logistics Solutions</span>
      <span>E-Commerce Fulfillment</span>
      <span>Island-Wide Coverage</span>
      <span>Bulk Shipping</span>
      <span>Tech-Powered Logistics</span>
      <!-- Loop padding duplicates -->
      <span>Same-Day Express Delivery</span>
      <span>Real-Time Package Tracking</span>
      <span>Corporate Logistics Solutions</span>
      <span>E-Commerce Fulfillment</span>
      <span>Island-Wide Coverage</span>
      <span>Bulk Shipping</span>
      <span>Tech-Powered Logistics</span>
    </div>
  </div>
</section>

<!-- Embedded viewport adapter override sheet styles -->
<style>
  @media (max-width: 960px) {
    .hero {
      height: auto !important;
      min-height: auto !important;
      padding: 7rem 0 3rem !important;
    }
    .hero .container > div {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
    .hero__title {
      font-size: 2.3rem !important;
    }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__actions .btn {
      justify-content: center;
    }
    .hero__visual-matrix {
      margin-bottom: 2rem;
    }
  }
</style>

<!-- QUICK TRACK -->
<div class="trackbar">
  <div class="container">
    <p class="trackbar__label">Have a tracking number? Check your shipment instantly.</p>
    <form class="trackbar__form" action="/tracking" method="POST">
      <div class="trackbar__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </div>
      <!-- 🌟 FIXED: Shifted reference window context to 2026 -->
      <input class="trackbar__input" type="text" name="trackingId" placeholder="Enter tracking ID — e.g. TXT-2026-001" autocomplete="off" />
      <button type="submit" class="trackbar__btn">
        Track
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </button>
    </form>
  </div>
</div>

<!-- SERVICES -->
<section class="services-section">
  <div class="container">
    <div class="section-header">
      <div>
        <div class="mono-label">What We Do</div>
        <h2 class="section-title">Our <em>Services</em></h2>
      </div>
      <a href="/services" class="btn btn-ghost">
        View All
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
    </div>

    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-card__num">01</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="service-card__title">Same-Day Express</div>
        <div class="service-card__desc">Pickup and delivery within the same business day across Greater Colombo and selected districts.</div>
      </div>

      <div class="service-card reveal" data-d="1">
        <div class="service-card__num">02</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="service-card__title">Standard Delivery</div>
        <div class="service-card__desc">Reliable 1–3 day island-wide delivery. Fully trackable with automated status notifications.</div>
      </div>

      <div class="service-card reveal" data-d="2">
        <div class="service-card__num">03</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <div class="service-card__title">Bulk & Corporate</div>
        <div class="service-card__desc">Dedicated account management and custom SLAs for high-volume enterprise shippers.</div>
      </div>

      <div class="service-card reveal" data-d="1">
        <div class="service-card__num">04</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
        </div>
        <div class="service-card__title">International Shipping</div>
        <div class="service-card__desc">Cross-border delivery to and from Sri Lanka via our partner network with documentation support.</div>
      </div>

      <div class="service-card reveal" data-d="2">
        <div class="service-card__num">05</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        </div>
        <div class="service-card__title">E-Commerce Fulfillment</div>
        <div class="service-card__desc">Seamless store integration with COD collection, returns handling, and remittance.</div>
      </div>

      <div class="service-card reveal" data-d="3">
        <div class="service-card__num">06</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="service-card__title">Live Tracking</div>
        <div class="service-card__desc">Built by Techo Labs — real-time shipment visibility for senders and recipients, 24/7.</div>
      </div>
    </div>
  </div>
</section>

