      </div>

      <div class="service-card reveal" data-d="3">
        <div class="service-card__num">06</div>
        <div class="service-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="service-card__title">Live Tracking</div>
        <div class="service-card__desc">Built by Techo Labs — real-time shipment visibility for senders and recipients, 24/7.</div>
