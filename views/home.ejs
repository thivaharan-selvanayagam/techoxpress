      <!-- Map Block -->
      <div class="map-box reveal" data-d="2">
        <div class="map-box__title">Island-Wide Coverage</div>
        <div class="map-box__svg-wrap" style="height: 320px;">
          <svg viewBox="0 0 300 400" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:100%;">
            <defs>
              <!-- 🌟 FIXED: Swapped out faint white dots for high-visibility light grey system points -->
              <pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse">
                <circle cx="1" cy="1" r="1" fill="rgba(15, 23, 42, 0.05)"/>
              </pattern>
            </defs>
            <rect width="300" height="400" fill="var(--bg-card)"/>
            <rect width="300" height="400" fill="url(#dots)"/>
            <!-- Island profile layout bounds -->
            <path d="M110 28 Q150 18 190 38 Q228 64 236 112 Q250 168 244 228 Q238 288 210 344 Q188 382 150 396 Q112 382 90 344 Q62 288 56 228 Q50 168 64 112 Q72 64 110 28Z"
              stroke="rgba(212,79,10,0.2)" stroke-width="1.5" fill="rgba(212,79,10,0.03)"/>
            <!-- Route path indicator strings -->
            <line x1="88" y1="218" x2="142" y2="142" stroke="rgba(212,79,10,0.25)" stroke-width="1" stroke-dasharray="5 3"/>
            <line x1="142" y1="142" x2="178" y2="44" stroke="rgba(212,79,10,0.2)" stroke-width="1" stroke-dasharray="5 3"/>
