<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero__bg"></div>
  <div class="page-hero__accent"></div>
  <div class="container">
    <div class="page-hero__label">Techo Xpress / Get In Touch</div>
    <h1 class="page-hero__title">LET'S GET<br>YOU <em>MOVING.</em></h1>
  </div>
</section>

<!-- CONTACT SECTION -->
<section class="contact-page">
  <div class="container">
    <div class="contact-grid">

      <!-- LEFT: Info -->
      <div>
        <div class="mono-label">Contact Us</div>
        <h2 class="section-title reveal" style="font-size:2rem; margin-bottom:1rem;">We're<br><em>Always On.</em></h2>
        <p style="color:var(--muted); font-size:0.925rem; line-height:1.8; margin-bottom:2rem;" class="reveal" data-d="1">
          Whether you need a same-day pickup, want to open a corporate account, or simply have a question — our team responds fast. Slow responses are not the Xpress way.
        </p>

        <div class="contact-info reveal" data-d="2">
          <div class="contact-info-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.1 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14z"/></svg>
            </div>
            <div>
              <div class="contact-lbl">Phone / WhatsApp</div>
              <div class="contact-val">+94 71 665 6007</div>
              <div class="contact-val-sub">Mon–Sat, 8:00 AM – 5:00 PM</div>
            </div>
          </div>

          <div class="contact-info-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <div class="contact-lbl">Email</div>
              <div class="contact-val">xpress@techotraders.com.lk</div>
              <div class="contact-val-sub">Response within 2 business hours</div>
            </div>
          </div>

          <div class="contact-info-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <div class="contact-lbl">Main Hub</div>
              <div class="contact-val">Batticaloa, Sri Lanka</div>
              <div class="contact-val-sub">Island-wide pickup & delivery</div>
            </div>
          </div>

          <div class="contact-info-item">
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
              <div class="contact-lbl">Immediate Pickup</div>
              <div class="contact-val">Call or WhatsApp for same-day</div>
              <div class="contact-val-sub">Cutoff: 4:00 PM for same-day express</div>
            </div>
          </div>
        </div>

        <!-- Parent co note -->
        <div style="margin-top:2rem; padding:1.1rem 1.25rem; background:var(--bg-card); border:1px solid var(--border); border-left:3px solid var(--orange); border-radius:var(--radius);" class="reveal" data-d="3">
          <div style="font-family:var(--font-mono); font-size:0.60rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted); margin-bottom:0.35rem;">Part of the Techo Ecosystem</div>
          <p style="font-size:0.875rem; color:var(--text); line-height:1.6;">Techo Xpress is a subsidiary of <a href="https://techotraders.com.lk" style="color:var(--orange);">Techo Traders</a>. For enterprise partnerships or investor inquiries, visit the parent company.</p>
        </div>
      </div>

      <!-- RIGHT: Form -->
      <div class="reveal" data-d="1">
        <% if (success) { %>
        <div class="form-alert form-alert--success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Your message was sent! We'll be in touch within 2 business hours.
        </div>
        <% } %>
        <% if (error) { %>
        <div class="form-alert form-alert--error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
        <% } %>

        <div class="contact-form-box">
          <div class="form-sub">Get a Quote or Ask a Question</div>
          <div class="form-heading">Send Us a Message</div>

          <form method="POST" action="/contact">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name" name="name" placeholder="Your full name" required />
              </div>
              <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="you@company.com" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="phone">Phone / WhatsApp</label>
                <input type="tel" id="phone" name="phone" placeholder="+94 XX XXX XXXX" />
              </div>
              <div class="form-group">
                <label for="company">Company Name</label>
                <input type="text" id="company" name="company" placeholder="Your business (optional)" />
              </div>
            </div>

            <div class="form-group">
              <label for="service">Service Interested In</label>
              <select id="service" name="service">
                <option value="">Select a service...</option>
                <option value="sameday">Same-Day Express</option>
                <option value="standard">Standard Delivery</option>
                <option value="bulk">Bulk & Corporate Account</option>
                <option value="ecommerce">E-Commerce Fulfillment</option>
                <option value="international">International Shipping</option>
                <option value="general">General Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" placeholder="Tell us about your shipping needs — volume, routes, timeline, or any special requirements..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:1rem; font-size:1.05rem;">
              Send Message
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- IMMEDIATE PICKUP BAND -->
<section class="cta-band" style="padding:3rem 0;">
  <div class="container">
    <div class="cta-band__inner">
      <div>
        <div class="cta-band__title" style="font-size:1.8rem;">Need an Immediate Pickup?</div>
        <div class="cta-band__sub">Call or WhatsApp directly — cutoff for same-day is 4:00 PM.</div>
      </div>
      <div class="cta-band__actions">
        <a href="tel:+94716656007" class="btn btn-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.1 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14z"/></svg>
          Call Now
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
