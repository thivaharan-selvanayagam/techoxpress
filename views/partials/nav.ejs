<style>
  /* ── 🌟 COMPACT HEADER RESETS ── */
  .site-nav {
    padding: 0.5rem 0 !important; /* Forces the header vertical padding to stay slim */
  }
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1.5rem !important; /* Optimizes horizontal spacing between text elements */
  }

  /* ── DESKTOP DROPDOWN VIEWPORT ARCHITECTURE ── */
  .site-nav__dropdown {
    position: relative;
    display: inline-block;
  }
  
  .site-nav__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--white, #ffffff);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color var(--speed);
    padding: 0.5rem 0;
  }

  .site-nav__dropdown-toggle:hover,
  .site-nav__dropdown-toggle.is-active {
    color: var(--orange, #D44F0A);
  }
  
  .site-nav__dropdown-toggle svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    transition: transform 0.25s ease;
  }
  
  /* Rotates chevron vector indicator on dropdown hover */
  .site-nav__dropdown:hover .site-nav__dropdown-toggle svg {
    transform: rotate(180deg);
  }
  
  .site-nav__dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #111111; /* Dark tech match for your console styling */
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius, 6px);
    min-width: 210px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 1100;
  }
  
  .site-nav__dropdown:hover .site-nav__dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(4px);
  }
  
  .site-nav__dropdown-menu a {
    display: block !important;
    padding: 0.65rem 1.25rem !important;
    font-size: 0.88rem !important;
    text-transform: none !important;
    letter-spacing: normal !important;
    color: var(--muted, #64748b) !important;
    transition: background 0.2s, color 0.2s;
    width: 100%;
    box-sizing: border-box;
    white-space: nowrap;
    text-align: left;
  }
  
  .site-nav__dropdown-menu a::after {
    display: none !important;
  }
  
  .site-nav__dropdown-menu a:hover,
  .site-nav__dropdown-menu a.is-active {
    background: rgba(255, 255, 255, 0.05) !important;
    color: var(--orange, #D44F0A) !important;
  }

  /* ── 📱 MOBILE SUB-GROUP ACCORDION STYLES ── */
  .site-nav__drawer-group {
    margin: 0.75rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--orange, #D44F0A);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  
  .site-nav__drawer-group-title {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted, #64748b);
    font-weight: 700;
    margin-bottom: 0.2rem;
    text-align: left;
  }
  
  .site-nav__drawer-group a {
    font-size: 1.25rem !important;
    font-weight: 700 !important;
    margin: 0 !important;
  }
</style>

<% 
  let isOperationsActive = (page === 'dispatch' || page === 'add-parcel' || page === 'report');
%>

<header class="site-nav" id="siteNav">
  <div class="site-nav__inner">

    <a href="/" class="site-nav__logo">
      <div class="site-nav__logo-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <polygon points="2,5 10,10 2,15" fill="white"/>
          <polygon points="9,3 18,10 9,17 11,10" fill="white" opacity="0.55"/>
        </svg>
      </div>
      <div>
        <div class="site-nav__logo-name">TECHO</div>
        <div class="site-nav__logo-sub">XPRESS</div>
      </div>
    </a>

    <nav class="site-nav__links">
      <a href="/"              class="<%= page==='home'       ? 'is-active':'' %>">Home</a>
      <a href="/services"      class="<%= page==='services'   ? 'is-active':'' %>">Services</a>
      <a href="/tracking"      class="<%= page==='tracking'   ? 'is-active':'' %>">Track Shipment</a>
      
      <% if (isLoggedIn) { %>
        <div class="site-nav__dropdown">
          <div class="site-nav__dropdown-toggle <%= isOperationsActive ? 'is-active' : '' %>">
            Terminal Ops 
            <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="site-nav__dropdown-menu">
            <a href="/dispatch"        class="<%= page==='dispatch'   ? 'is-active':'' %>">Dispatch Desk</a>
            <a href="/dispatch/add"    class="<%= page==='add-parcel' ? 'is-active':'' %>">Parcel Intake</a>
            <a href="/dispatch/report" class="<%= page==='report'     ? 'is-active':'' %>">Ledger Reports</a>
          </div>
        </div>
        <a href="/logout"          style="color: #e74c3c;">Logout ✕</a>
      <% } else { %>
        <a href="/about"         class="<%= page==='about'      ? 'is-active':'' %>">About</a>
        <a href="/login"         class="<%= page==='login'      ? 'is-active':'' %>">Staff Login ➔</a>
      <% } %>
      
      <a href="/contact"       class="site-nav__cta">Get a Quote</a>
    </nav>

    <button class="site-nav__burger" id="navBurger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="site-nav__drawer" id="navDrawer">
    <button class="site-nav__drawer-close" id="navClose" aria-label="Close menu">✕</button>
    <a href="/" class="<%= page==='home' ? 'is-active':'' %>">Home</a>
    <a href="/services" class="<%= page==='services' ? 'is-active':'' %>">Services</a>
    
    <% if (isLoggedIn) { %>
      <div class="site-nav__drawer-group">
        <div class="site-nav__drawer-group-title">Terminal Operations</div>
        <a href="/tracking" class="<%= page==='tracking' ? 'is-active':'' %>">Track Shipment</a>
        <a href="/dispatch" class="<%= page==='dispatch' ? 'is-active':'' %>">Dispatch Desk</a>
        <a href="/dispatch/add" class="<%= page==='add-parcel' ? 'is-active':'' %>">Parcel Intake</a>
        <a href="/dispatch/report" class="<%= page==='report' ? 'is-active':'' %>">Ledger Reports</a>
      </div>
      <a href="/logout" style="color: #e74c3c !important;">Logout ✕</a>
    <% } else { %>
      <a href="/tracking" class="<%= page==='tracking' ? 'is-active':'' %>">Track Shipment</a>
      <a href="/about" class="<%= page==='about' ? 'is-active':'' %>">About</a>
      <a href="/login" class="<%= page==='login' ? 'is-active':'' %>">Staff Login ➔</a>
    <% } %>
    
    <a href="/contact" style="margin-top: 1rem; text-align: center; display: block; background: var(--orange); color: white; padding: 0.8rem; border-radius: var(--radius); font-weight: bold; text-decoration: none;">Get a Quote</a>
  </div>
  
  <div class="site-nav__overlay" id="navOverlay"></div>
</header>