<header class="site-nav" id="siteNav">
  <div class="site-nav__inner">

    <a href="/" class="site-nav__logo">
      <div class="site-nav__logo-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <polygon points="2,5 10,10 2,15" fill="white"/>
          <polygon points="9,3 18,10 9,17 11,10" fill="white" opacity="0.55"/>
        </svg>
      </div>
      <div>
        <div class="site-nav__logo-name">TECHO</div>
        <div class="site-nav__logo-sub">XPRESS</div>
      </div>
    </a>

    <nav class="site-nav__links">
      <a href="/"              class="<%= page==='home'       ? 'is-active':'' %>">Home</a>
      <a href="/services"      class="<%= page==='services'   ? 'is-active':'' %>">Services</a>
      <a href="/tracking"      class="<%= page==='tracking'   ? 'is-active':'' %>">Track Shipment</a>
      
