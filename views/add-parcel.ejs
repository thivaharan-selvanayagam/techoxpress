        <div style="margin-top: 2rem; text-align: center;">
          <a href="/dispatch" style="color: var(--muted); font-family: var(--font-mono); font-size: 0.8rem; text-decoration: none; border-bottom: 1px dashed var(--border); padding-bottom: 0.2rem;">➔ Return to Fleet Dispatch Desk</a>
