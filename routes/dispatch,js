const express = require('express');
const router = express.Router();
const Rider = require('../models/Rider');
const Parcel = require('../models/Parcel');

// ── HELPER DATA ENGINE ──
// Collects the complete logistics dataset needed to power all dashboard rows/columns
const getTerminalDataset = async () => {
  const allRiders = await Rider.find({});
  const activeRiders = allRiders.filter(r => r.status === 'Available');
  const transitRiders = allRiders.filter(r => r.status === 'In Transit');
  
  // 📥 Fetch all parcels currently sitting in the office (unassigned and not delivered)
  const officeParcels = await Parcel.find({ 
    assignedRider: null, 
    status: { $ne: 'delivered' } 
  });

  // 🏍️ Dynamically map out active packages currently on the road for each transit rider
  const dynamicFleet = await Promise.all(transitRiders.map(async (rider) => {
    const activePackages = await Parcel.find({ 
      assignedRider: rider._id, 
      status: { $ne: 'delivered' } 
    });
    return { rider, activePackages };
  }));

  return {
    riders: activeRiders,  // Pool for the dispatch selection dropdown
    allRiders,            // Pool for performance metric rows
    officeParcels,        // Pool for the office inventory stacks table
    dynamicFleet          // Pool for the live transit monitor tracks
  };
};

// ── GET: Load main terminal window data packages ──
router.get('/', async (req, res) => {
  try {
    const dataset = await getTerminalDataset();
    res.render('dispatch', { 
      title: 'Xpress Dispatch Terminal', 
      page: 'dispatch', 
      ...dataset, 
      success: false, 
      error: null 
    });
  } catch (err) {
    console.error('Core interface fetch failure:', err);
    res.render('dispatch', { 
      title: 'Xpress Dispatch Terminal', 
      page: 'dispatch', 
      riders: [], allRiders: [], officeParcels: [], dynamicFleet: [],
      success: false, 
      error: 'Failed to stream active logistics terminal datasets.' 
    });
  }
});

// ── POST: Bind barcode array batch vectors to database rows ──
router.post('/commit', async (req, res) => {
  const { riderId, trackingIds } = req.body;
  const parsedIds = Array.isArray(trackingIds) ? trackingIds : [trackingIds].filter(Boolean);

  try {
    const targetRider = await Rider.findById(riderId);
    if (!targetRider || parsedIds.length === 0) {
      throw new Error('Verification parameters mismatched.');
    }

    const currentTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const currentDate = 'Today';

    // Atomic Update Sequence: Finds scanned tracking IDs and injects assignments/events
    await Parcel.updateMany(
      { trackingId: { $in: parsedIds } },
      {
        $set: { 
          assignedRider: targetRider._id,
          status: 'transit', // Set master programmatic state to transit
          statusLabel: 'Out for Delivery',
          eta: 'Arriving Today'
        },
        $push: {
          events: {
            $each: [{
              time: currentTime,
              date: currentDate,
              label: 'Rider Dispatched',
              desc: `Package assigned to freelance courier ${targetRider.name} (${targetRider.phone}).`,
              done: true
            }],
            $position: 0 // Injects new logs right at the top of the timeline
          }
        }
      }
    );

    // Pivot courier state to tracking mode
    targetRider.status = 'In Transit';
    await targetRider.save();

    // Fetch the updated dataset so the UI updates layout elements immediately
    const dataset = await getTerminalDataset();
    
    res.render('dispatch', { 
      title: 'Xpress Dispatch Terminal', 
      page: 'dispatch', 
      ...dataset,
      success: `Successfully assigned ${parsedIds.length} parcel(s) to ${targetRider.name}. Manifest active.`, 
      error: null 
    });

  } catch (err) {
    console.error('Commit execution fault:', err);
    const dataset = await getTerminalDataset().catch(() => ({ riders: [], allRiders: [], officeParcels: [], dynamicFleet: [] }));
    
    res.render('dispatch', { 
      title: 'Xpress Dispatch Terminal', 
      page: 'dispatch', 
      ...dataset,
      success: false, 
      error: 'Execution transaction rolled back: ' + err.message 
    });
  }
});

module.exports = router;